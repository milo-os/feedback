# Milo in the test-infra cluster, as Milo's test admin (system:masters).
apiVersion: v1
kind: Config
clusters:
  - name: milo
    cluster:
      server: https://localhost:30443
      insecure-skip-tls-verify: true
users:
  - name: admin
    user:
      token: test-admin-token
contexts:
  - name: milo
    context: {cluster: milo, user: admin}
current-context: milo
